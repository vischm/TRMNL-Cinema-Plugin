<div class="layout layout--col layout--stretch">
  {% if movies.size > 0 %}
    <div class="cinema-grid grid grid--cols-1 gap--small">
      {% for movie in movies limit: 4 %}
        <div class="quadrant-film{% if forloop.index > 3 %} movie--lg-only{% endif %}">
          {% comment %} No "and N more": the label is taller than a line and would push out the only line that fits {% endcomment %}
          {% render "movie_text", movie: movie, show_rating: true, no_counter: true %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    {% render "notice", error: error, city: city %}
  {% endif %}
</div>

{% render "title_bar", city: city, day: day, error: error, movies: movies, updated_at: updated_at %}
