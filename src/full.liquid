<div class="layout layout--col layout--stretch">
  {% if movies.size > 0 %}
    <div class="cinema-grid grid grid--cols-3 gap--large portrait:grid--cols-1">
      {% for movie in movies limit: 3 %}
        {% render "movie_card", movie: movie %}
      {% endfor %}
    </div>
  {% else %}
    {% render "notice", error: error, city: city %}
  {% endif %}
</div>

{% render "title_bar", city: city, day: day, error: error, movies: movies, updated_at: updated_at, today: today, locale: trmnl.user.locale, show_date: true %}
