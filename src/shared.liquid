<style>
  /* Sizes follow the view and --ui-scale, so the views also fit TRMNL X and portrait screens */
  .cinema-grid {
    height: 100%;
    min-height: 0;
    grid-auto-rows: minmax(0, 1fr);  /* equal rows, so a long cinema list overflows into "and N more" */
  }

  .movie {
    display: grid;
    min-width: 0;  /* a long cinema name must not widen its column into the gap */
    min-height: 0;
    grid-template-rows: auto auto minmax(0, 1fr);
    grid-template-areas: "title" "poster" "cinemas";
    gap: calc(10px * var(--ui-scale, 1));
  }

  .movie__title {
    grid-area: title;
    height: calc(var(--full-h) * 0.15);
    padding: 0 calc(8px * var(--ui-scale, 1));
    border-radius: calc(10px * var(--ui-scale, 1));
  }

  .movie__poster {
    grid-area: poster;
    position: relative;
    justify-self: center;
  }

  .movie__image {
    display: block;
    height: calc(var(--full-h) * 0.28);
    width: auto;
    aspect-ratio: 2 / 3;  /* reserves the poster's space before it has loaded */
    object-fit: cover;
    border-radius: calc(10px * var(--ui-scale, 1));
  }

  .movie__rating {
    position: absolute;
    right: calc(-12px * var(--ui-scale, 1));
    bottom: calc(-4px * var(--ui-scale, 1));
    padding: calc(8px * var(--ui-scale, 1)) calc(10px * var(--ui-scale, 1));
    border-radius: calc(10px * var(--ui-scale, 1));
  }

  .movie__cinemas {
    grid-area: cinemas;
    min-width: 0;
    min-height: 0;
  }

  /* CSS ellipsis instead of data-clamp: the framework measures the whole item, grey bar included,
     so a clamped name still ran past the edge */
  .movie__cinemas .content {
    min-width: 0;
  }

  .movie__cinemas .movie__cinema-name {
    display: block;
    align-self: stretch;  /* .item .content doesn't stretch its children, so the name never overflowed itself */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .movie__time {
    white-space: nowrap;
    padding: calc(5px * var(--ui-scale, 1));
    height: calc(27px * var(--ui-scale, 1));
    border-radius: calc(10px * var(--ui-scale, 1));
  }

  /* Portrait: poster on the left, title and cinemas next to it */
  .screen--portrait .view--full .movie {
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-areas: "poster title" "poster cinemas";
  }

  .screen--portrait .view--full .movie__title {
    height: auto;
    padding: calc(6px * var(--ui-scale, 1)) calc(8px * var(--ui-scale, 1));
  }

  .screen--portrait .view--full .movie__poster {
    align-self: start;
    margin-right: calc(14px * var(--ui-scale, 1));
  }

  .screen--portrait .view--full .movie__image {
    height: calc(var(--full-h) * 0.22);
  }

  /* TRMNL X (screen--lg) lays out at 1040 x 780 CSS px: it gets a fourth film and a lower title box,
     so each column's cinema list gets the rest of the height. Other screens hide the fourth film. */
  .screen:not(.screen--lg) .movie--lg-only {
    display: none;
  }

  .screen--lg .view--full .cinema-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  /* Four compact cards side by side leave too little room next to the posters: 2 x 2 instead */
  .screen--lg .view--half_horizontal .cinema-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .screen--lg.screen--portrait .view--full .cinema-grid,
  .screen--lg.screen--portrait .view--half_horizontal .cinema-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .screen--lg:not(.screen--portrait) .view--full .movie__title {
    height: calc(80px * var(--ui-scale, 1));
  }

  /* The extra height goes to a larger poster; names and showtimes are a size up (lg: classes) */
  .screen--lg:not(.screen--portrait) .view--full .movie__image {
    height: calc(var(--full-h) * 0.36);
  }

  .screen--lg:not(.screen--portrait) .movie__time {
    height: auto;
  }

  .screen--lg:not(.screen--portrait) .movie__cinemas .movie__cinema-name {
    /* title--base is regular weight; keep the names as strong as on OG (4-bit screens weigh fonts by wght) */
    font-weight: 700;
    font-variation-settings: "wght" 700;
  }

  .screen--lg.screen--portrait .view--full .movie__image {
    height: calc(var(--full-h) * 0.17);
  }

  .screen--lg:not(.screen--portrait) .view--half_horizontal .movie-row .movie__image {
    height: calc(140px * var(--ui-scale, 1));
  }

  .screen--lg .view--half_vertical .movie-row .movie__image {
    height: calc(140px * var(--ui-scale, 1));
  }

  .title_bar__date {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Portrait title bars are too narrow for an exact centre next to "Tomorrow in Theaters":
     centre the date between title and city instead */
  .screen--portrait .title_bar__date {
    position: static;
    transform: none;
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
    white-space: nowrap;
  }

  /* Compact rows of the half views: poster, then the film's text filling the rest of the row */
  .movie-row {
    min-height: 0;
    align-items: stretch;
  }

  .movie-row .movie__poster {
    flex-shrink: 0;
    align-self: center;
  }

  /* Title plus one line per cinema with all its showtimes; the lines take the height that is left
     and end in "and N more". The wrapper gives the overflow engine that height as its budget. */
  .movie-text {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    gap: calc(4px * var(--ui-scale, 1));
  }

  .movie-text__title {
    align-self: stretch;  /* data-clamp measures this width */
  }

  .movie-text__cinemas {
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
  }

  .movie-text__cinemas .content {
    min-width: 0;
  }

  .movie-text__line {
    display: block;
    align-self: stretch;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .movie-text__cinema {
    font-weight: bold;
  }

  /* Quadrant: one block per film in equal rows, with a bar like the framework's items */
  .quadrant-film {
    display: flex;
    min-height: 0;
    padding-left: calc(10px * var(--ui-scale, 1));
    border-left: calc(4px * var(--ui-scale, 1)) solid currentColor;
  }

  /* No room next to the poster in compact rows: keep the rating badge inside it */
  .movie-row .movie__rating {
    right: calc(4px * var(--ui-scale, 1));
    bottom: calc(4px * var(--ui-scale, 1));
    padding: calc(4px * var(--ui-scale, 1)) calc(6px * var(--ui-scale, 1));
    border-radius: calc(8px * var(--ui-scale, 1));
  }

  /* Only --full-h follows the device, so the compact posters scale with --ui-scale like the text */
  .view--half_horizontal .movie-row .movie__image {
    height: calc(135px * var(--ui-scale, 1));
  }

  .screen--portrait .view--half_horizontal .movie-row .movie__image {
    height: calc(95px * var(--ui-scale, 1));
  }

  .view--half_vertical .movie-row .movie__image {
    height: calc(115px * var(--ui-scale, 1));
  }

  .screen--portrait .view--half_vertical .movie-row .movie__image {
    height: calc(130px * var(--ui-scale, 1));
  }
</style>

{% template poster %}
  <div class="movie__poster">
    {% if movie.poster_url %}
      <img class="image image-dither movie__image" src="{{ movie.poster_url }}" alt="">
    {% else %}
      <svg class="movie__image image-stroke" viewBox="0 0 2 3" xmlns="http://www.w3.org/2000/svg">
        <rect x="0.05" y="0.05" width="1.9" height="2.9" rx="0.15" fill="none" stroke="currentColor" stroke-width="0.06"/>
        <path d="M0.6 1.2h0.8v0.6h-0.8z M1.4 1.35l0.25-0.15v0.6l-0.25-0.15z" fill="currentColor"/>
      </svg>
    {% endif %}
    {% if movie.rating %}
      <span class="label label--outline bg--white movie__rating">{{ movie.rating }}</span>
    {% endif %}
  </div>
{% endtemplate %}

{% template movie_card %}
  <div class="movie{% if extra %} movie--lg-only{% endif %}">
    <div class="movie__title flex flex--row flex--center bg--gray-65">
      <span class="content content--large text--center text-stroke text-stroke--large" data-clamp="2">{{ movie.title }}</span>
    </div>
    {% render "poster", movie: movie %}
    {% comment %} The overflow engine budgets the list by its parent's height: this wrapper is the space left {% endcomment %}
    <div class="movie__cinemas">
    <div class="flex flex--col gap--small" data-overflow="true" data-overflow-counter="true">
      {% for cinema in movie.cinemas %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="title title--small lg:landscape:title--base movie__cinema-name">{{ cinema.cinema }}</span>
            <div class="flex flex--wrap gap--xsmall">
              {% for screening in cinema.screenings %}
                <span class="label label--outline label--small lg:landscape:label--base movie__time">{{ screening.time }}{% for tag in screening.tags %} {{ tag }}{% endfor %}</span>
              {% endfor %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    </div>
  </div>
{% endtemplate %}

{% template movie_text %}
  <div class="movie-text">
    <span class="title title--small movie-text__title" data-clamp="2">{% if show_rating and movie.rating %}{{ movie.rating }} · {% endif %}{{ movie.title }}</span>
    <div class="movie-text__cinemas">
      <div class="flex flex--col gap--xsmall" data-overflow="true"{% unless no_counter %} data-overflow-counter="true"{% endunless %}>
        {% for cinema in movie.cinemas %}
          <div class="item">
            <div class="content">
              {% comment %} Times first: a long cinema name must not push them out of sight {% endcomment %}
              <span class="description movie-text__line">{% for screening in cinema.screenings %}{{ screening.time }}{% for tag in screening.tags %} {{ tag }}{% endfor %}{% unless forloop.last %}, {% endunless %}{% endfor %} <span class="movie-text__cinema">{{ cinema.cinema }}</span></span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endtemplate %}

{% template movie_row %}
  <div class="movie-row flex flex--row flex--left{% if extra %} movie--lg-only{% endif %}">
    {% render "poster", movie: movie %}
    {% render "movie_text", movie: movie %}
  </div>
{% endtemplate %}

{% template notice %}
  <div class="flex flex--col flex--center gap--small h--full text--center">
    {% if error != blank %}
      <span class="title">No cinema programme</span>
      <span class="description" data-clamp="4">{{ error }}</span>
    {% else %}
      <span class="title">No screenings</span>
      <span class="description" data-clamp="3">cinema.de lists no more screenings for {{ city }} today or tomorrow.</span>
    {% endif %}
  </div>
{% endtemplate %}

{% template title_bar %}
  <div class="title_bar">
    {% comment %} Material Symbols "theaters" (Apache License 2.0), same as assets/theaters.svg {% endcomment %}
    <svg class="image-stroke" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 -960 960 960">
      <path d="M160-120v-720h80v80h80v-80h320v80h80v-80h80v720h-80v-80h-80v80H320v-80h-80v80h-80Zm80-160h80v-80h-80v80Zm0-160h80v-80h-80v80Zm0-160h80v-80h-80v80Zm400 320h80v-80h-80v80Zm0-160h80v-80h-80v80Zm0-160h80v-80h-80v80ZM400-200h160v-560H400v560Zm0-560h160-160Z"/>
    </svg>
    <span class="title">{% if day == "tomorrow" %}Tomorrow in Theaters{% else %}Now in Theaters{% endif %}</span>
    {% if show_date and today %}
      <span class="instance title_bar__date">{{ today | l_date: "%a, %-d %b", locale }}</span>
    {% endif %}
    <span class="instance">{{ city }}{% if error != blank and movies.size > 0 %} · offline since {{ updated_at }}{% endif %}</span>
  </div>
{% endtemplate %}
