<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="https://usetrmnl.com/css/latest/plugins.css">
    <script src="https://usetrmnl.com/js/latest/plugins.js"></script>
</head>

<body class="environment trmnl">
    <div class="screen">
        <div class="view view--full">

            <!-- Start TRMNL Code -->
            <style>
                .movie_title {
                    height: 52px;
                    word-break: break-word !important;
                    /* Prevents line breaks inside words */
                }

                .movie_poster {
                    height: 130px;
                    object-fit: contain;
                    border-radius: 10px !important;
                }

                .movie_rating {
                    padding: 10px !important;
                    padding-bottom: 8px !important;
                    height: 100% !important;
                    border-radius: 10px !important;
                    margin-left: -35px !important;
                    margin-top: 95px !important;
                    background-color: white;
                    margin-bottom: -10px !important;
                }

                .movie_timeslot {
                    padding: 5px !important;
                    height: 27px !important;
                    border-radius: 10px !important;
                }
            </style>

            <div class="layout layout--top">
                <div class="columns gap--large">
                    {% for movie in movies limit:4 %}
                    <div class="column" data-list-limit="true" data-list-max-height="180" data-list-hidden-count="true">
                        <span class="title clamp--2 movie_title back">{{movie.title}}</span>
                        <div class="flex flex--row flex--top">
                            <img class="image-dither movie_poster"
                                src={{movie.poster_url}}>
                            <span class="label label--outline movie_rating">{{movie.rating}}</span>
                        </div>
                        {% for cinema in movie.cinemas %}
                        <div class="item">
                            <div class="meta"></div>
                            <div class="content">
                                <span class="title title--small">{{cinema.name}}</span>
                                <div class="flex gap--small" style="margin-top: 5px; flex-wrap: wrap;">
                                    {% for screening in cinema.screenings %}
                                        <span class="label label--outline label--small movie_timeslot">
                                            {{ screening.time }} 
                                            {% for tag in screening.tags %} {{ tag }} {% endfor %}
                                        </span>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                        {% endfor  %}
                    </div> 
                    {% endfor %}                   
                </div>
            </div>

            <div class="title_bar">
                <img class="image" src="https://usetrmnl.com/images/plugins/trmnl--render.svg" />
                <span class="title">Now in Theaters</span>
                <span class="instance">Leipzig</span>
            </div>
            <!-- End TRMNL Code -->

        </div>
    </div>
</body>

</html>