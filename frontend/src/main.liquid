<!doctype html>
<html>
  <head>
    <link rel="stylesheet" href="https://usetrmnl.com/css/latest/plugins.css">
    <script src="https://usetrmnl.com/js/latest/plugins.js"></script>
  </head>

  <body class="environment trmnl">
    <div class="screen">
      <div class="view view--full">
        <!-- Start TRMNL Code -->
        <style>
          .movie_poster {
            height: 130px;
            object-fit: contain;
            border-radius: 10px !important;
          }

          .movie_rating {
            padding: 10px !important;
            padding-bottom: 8px !important;
            height: 100% !important;
            border-radius: 10px !important;
            margin-left: -35px !important;
            margin-top: 95px !important;
            background-color: white;
            margin-bottom: -10px !important;
          }

          .movie_timeslot {
            padding: 5px !important;
            height: 27px !important;
            border-radius: 10px !important;
          }
        </style>

        <div class="layout layout--top">
          <div class="columns gap--large">
            {% for movie in movies limit: 4 %}
              <div class="column">
                <div class="layout richtext h--[70px] bg--gray-65 rounded">
                  <div class="content content--large text--center text-stroke text-stroke--large m--1.5" data-clamp="3">
                    {{ movie.title }}
                  </div>
                </div>
                <div class="flex flex--row flex--top">
                  <img
                    class="image-dither movie_poster"
                    src="{{movie.poster_url | default: "https://usetrmnl.com/images/plugins/trmnl--render.svg"}}"
                  >
                  {% if movie.rating %}
                    <span class="label label--outline movie_rating">{{ movie.rating }}</span>
                  {% endif %}
                </div>
                <div class="flex flex--col gap--small" data-overflow="true" data-overflow-counter="true">
                  {% for cinema in movie.cinemas %}
                    <div class="item">
                      <div class="meta"></div>
                      <div class="content">
                        <span class="title title--small">{{ cinema.cinema }}</span>
                        <div class="flex gap--small" style="margin-top: 5px; flex-wrap: wrap;">
                          {% for screening in cinema.screenings %}
                            <span class="label label--outline label--small movie_timeslot">
                              {{ screening.time }}
                              {% for tag in screening.tags %}
                                {{ tag }}
                              {% endfor %}
                            </span>
                          {% endfor %}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="title_bar">
          <svg
            class="image-stroke"
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            fill="currentColor"
            class="bi bi-camera-reels-fill"
            viewBox="0 0 16 16"
          >
            <path d="M6 3a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
            <path d="M9 6a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
            <path d="M9 6h.5a2 2 0 0 1 1.983 1.738l3.11-1.382A1 1 0 0 1 16 7.269v7.462a1 1 0 0 1-1.406.913l-3.111-1.382A2 2 0 0 1 9.5 16H2a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>
          </svg>
          <span class="title">Now in Theaters</span>
          <span class="instance">Leipzig</span>
        </div>
        <!-- End TRMNL Code -->
      </div>
    </div>
  </body>
</html>
